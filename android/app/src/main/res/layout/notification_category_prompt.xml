<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded body of a "needs a category" notification: what was paid,
  and the pills that answer for it.

  `screens/Fit C · Text pills that wrap@1x.png`. No icons. Six category
  marks drawn at twenty points each were six things to read before the
  words under them could be read, and the words were the answer. A tinted
  pill carrying the name is one thing to read, and it is the name.

  Three to a row, two rows, rather than one row that wraps: a RemoteViews
  has no flow layout, and six across a narrow phone truncated `Groceries`
  and `Transport` into `Grocer…` and `Transp…`. Fixed rows cannot
  truncate, and three short words fit the narrowest phone the app supports.

  Each pill is one TextView wearing the shape as its background, tinted
  from code. It was a TextView over an ImageView holding the shape, which
  drew nothing: FrameLayout only re-measures its match_parent children when
  there is more than one of them, so the lone background never took the
  width the label had settled on.

  The title and the line under it are repeated here rather than left to the
  notification template. DecoratedCustomViewStyle keeps the app name, the
  time and the expander chrome, but the custom view REPLACES the content
  area rather than sitting below it — so a layout holding only the pills
  expands into a card that has forgotten which payment it is about. The
  collapsed card still uses the standard template and needs none of this.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/prompt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/prompt_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/pill_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/pill_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/notif_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pill_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/notif_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pill_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/notif_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pill_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/pill_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/notif_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pill_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/notif_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pill_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/notif_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
